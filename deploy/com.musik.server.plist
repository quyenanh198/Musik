<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: deploy/install-launchd.sh fills in __NODE__, __REPO__ and __HOME__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.musik.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/node_modules/tsx/dist/cli.mjs</string>
    <string>__REPO__/server/index.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PORT</key>
    <string>3000</string>
    <key>MUSIK_DATA_DIR</key>
    <string>__REPO__/data</string>
  </dict>

  <!-- Start at login and restart if the process exits. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/musik.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/musik.log</string>
</dict>
</plist>
